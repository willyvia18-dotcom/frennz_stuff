@section('scripts')
<script>
  const statusOptions = ["Diproses","Dikirim","Selesai","Dibatalkan"];
  const statusClass = { "Diproses":"processing","Dikirim":"shipped","Selesai":"done","Dibatalkan":"cancelled" };

  function render() {
    const orders = getOrders();
    document.getElementById("count-label").textContent = orders.length + " pesanan";
    document.getElementById("order-rows").innerHTML = orders.map((o,i) => `
      <tr>
        <td>#${o.id}</td><td>${o.buyer.name}</td><td>${new Date(o.date).toLocaleDateString("id-ID")}</td>
        <td>${o.items.reduce((s,it)=>s+it.qty,0)} pcs</td><td>${formatRupiah(o.total)}</td>
        <td><select class="select-status no-print" data-status="${i}">${statusOptions.map(s=>`<option value="${s}" ${s===o.status?"selected":""}>${s}</option>`).join("")}</select></td>
        <td class="no-print"><button class="icon-action" data-invoice="${i}">Invoice</button></td>
      </tr>`).join("") || `<tr><td colspan="7" class="text-muted center">Belum ada pesanan masuk</td></tr>`;

    document.querySelectorAll("[data-status]").forEach(sel => sel.onchange = () => {
      const orders = getOrders(); orders[+sel.dataset.status].status = sel.value; writeLS(LS_KEYS.orders, orders); render(); showToast("Status diperbarui");
    });
    document.querySelectorAll("[data-invoice]").forEach(b => b.onclick = () => showInvoice(getOrders()[+b.dataset.invoice]));
  }

  function showInvoice(o) {
    document.getElementById("invoice-modal").innerHTML = `
      <h3>Invoice #${o.id}</h3>
      <p class="text-muted" style="font-size:12px">${new Date(o.date).toLocaleDateString("id-ID",{day:"numeric",month:"long",year:"numeric"})}</p>
      <div style="margin:14px 0;font-size:14px;"><strong>${o.buyer.name}</strong><br>${o.buyer.phone} · ${o.buyer.email}<br>${o.address.line}, ${o.address.city} ${o.address.postal}</div>
      <table class="table" style="margin-bottom:14px;">
        <thead><tr><th>Item</th><th>Qty</th><th>Subtotal</th></tr></thead>
        <tbody>${o.items.map(it => `<tr><td>${it.name} (${it.size}, ${it.color})</td><td>${it.qty}</td><td>${formatRupiah(it.price*it.qty)}</td></tr>`).join("")}</tbody>
      </table>
      <div class="summary-row"><span>Ongkir</span><span>${formatRupiah(o.shipping)}</span></div>
      ${o.discount ? `<div class="summary-row"><span>Voucher ${o.voucher||""}</span><span>-${formatRupiah(o.discount)}</span></div>` : ""}
      <div class="summary-row total"><span>Total</span><span>${formatRupiah(o.total)}</span></div>
      <div class="no-print" style="display:flex;gap:10px;margin-top:18px;">
        <button class="btn btn-ghost" id="close-invoice">Tutup</button>
        <button class="btn btn-primary" onclick="window.print()">Cetak Invoice</button>
      </div>`;
    document.getElementById("modal-overlay").classList.add("open");
    document.getElementById("close-invoice").onclick = () => document.getElementById("modal-overlay").classList.remove("open");
  }
  document.getElementById("modal-overlay").addEventListener("click", e => { if (e.target.id === "modal-overlay") e.target.classList.remove("open"); });

  render();
</script>
