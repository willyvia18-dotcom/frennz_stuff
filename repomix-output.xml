@section('scripts')
<script>
  function render() {
    const promos = getPromos();
    document.getElementById("promo-rows").innerHTML = promos.map((p,i) => `
      <tr>
        <td style="font-weight:600;">${p.code}</td>
        <td>${p.type === "percent" ? "Persen" : "Tetap"}</td>
        <td>${p.type === "percent" ? p.value + "%" : formatRupiah(p.value)}</td>
        <td>${p.desc || "—"}</td>
        <td><button class="toggle-pill ${p.active ? "on" : "off"}" data-toggle="${i}">${p.active ? "Aktif" : "Nonaktif"}</button></td>
        <td><button class="icon-action danger" data-delete="${i}">Hapus</button></td>
      </tr>`).join("") || `<tr><td colspan="6" class="text-muted center">Belum ada voucher</td></tr>`;

    document.querySelectorAll("[data-toggle]").forEach(b => b.onclick = () => {
      const promos = getPromos(); promos[+b.dataset.toggle].active = !promos[+b.dataset.toggle].active; savePromos(promos); render();
    });
    document.querySelectorAll("[data-delete]").forEach(b => b.onclick = () => {
      if (confirm("Hapus voucher ini?")) { const promos = getPromos(); promos.splice(+b.dataset.delete,1); savePromos(promos); render(); showToast("Voucher dihapus"); }
    });
  }
  const overlay = document.getElementById("modal-overlay");
  document.getElementById("add-btn").onclick = () => overlay.classList.add("open");
  document.getElementById("modal-close").onclick = () => overlay.classList.remove("open");
  overlay.addEventListener("click", e => { if (e.target === overlay) overlay.classList.remove("open"); });

  document.getElementById("promo-form").addEventListener("submit", e => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const promos = getPromos();
    promos.unshift({ code: fd.get("code").toUpperCase(), type: fd.get("type"), value: Number(fd.get("value")), desc: fd.get("desc"), active: true });
    savePromos(promos);
    overlay.classList.remove("open");
    e.target.reset();
    render();
    showToast("Voucher ditambahkan");
  });

  render();
</script>
@endsection
